# STAGING frontend settings. Copy to .env on the frontend server (172.28.92.56):
#   cp .env.example .env
# docker compose reads .env from this folder automatically. Never commit .env.

# Backend server, private address and published port (deploy/staging/backend).
BACKEND_URL=http://172.28.92.57:5070

# Host port users open: http://172.28.92.56:<FRONTEND_HOST_PORT>/
# If you change it, also change the Hub redirect URI and SSO_REDIRECT_URI on the backend.
FRONTEND_HOST_PORT=3070
