# PRODUCTION backend settings. Copy to .env.production on the backend server (172.28.80.51)
# and replace every REPLACE_ME. Never commit .env.production.

# --- Apsara RDS for PostgreSQL ------------------------------------------------
DATABASE_HOST=pgm-d9jn3khh0b3907w4.pgsql.ap-southeast-5.rds.aliyuncs.com
DATABASE_PORT=5432
DATABASE_NAME=plantation_rainfall
DATABASE_USER=rainfall_app
DATABASE_PASSWORD=REPLACE_ME
# Encrypt the database connection (Apsara RDS supports SSL once enabled in the console;
# use prefer if SSL is not enabled on the instance yet).
DATABASE_SSLMODE=require
# Open database connections kept per backend process.
DATABASE_POOL_SIZE=10

# --- Dashboard ------------------------------------------------------------------
# Address users open (the frontend server).
DASHBOARD_PUBLIC_URL=http://172.28.80.50:3070/

# --- Sign-in --------------------------------------------------------------------
SESSION_HOURS=12
# The dashboard is served over plain HTTP (http://172.28.80.50:3070); set true once it
# is served over HTTPS (see the deployment guide, section 13).
SESSION_COOKIE_SECURE=false
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12
# Keep email + password sign-in for a break-glass administrator.
LOCAL_LOGIN_ENABLED=true

# --- DWS Hub single sign-on (OIDC code + PKCE) ----------------------------------
SSO_ENABLED=true
SSO_LABEL=Sign in with DWS Hub
# Production Hub discovery document (HTTPS; the hostname is pinned to 172.28.80.50 in docker-compose.yml).
SSO_DISCOVERY_URL=https://dwshub.kpndomain.com/api/sso/.well-known/openid-configuration
# oauth_client_id registered for this app in Hub Admin.
SSO_CLIENT_ID=plantation-rainfall
# Only if the Hub registration has a client secret.
SSO_CLIENT_SECRET=
# Must exactly match an entry in the app's oidc_redirect_uris in Hub Admin.
SSO_REDIRECT_URI=http://172.28.80.50:3070/api/sso/callback
# Leave empty: the Hub's authorize page (https://dwshub.kpndomain.com) opens from user PCs.
SSO_AUTHORIZATION_URL=
SSO_SCOPES=openid profile email
# Role for Hub users without a dashboard account (admin, plantation, regional);
# empty = only users an administrator has registered can sign in.
SSO_AUTO_PROVISION_ROLE=

# --- SAP / Syncera (PROD only) ----------------------------------------------------
SYNCERA_PROD_BASE_URL=https://syncera.gamasap.com/api/v1
SYNCERA_PROD_CLIENT_ID=cli_300bf7eb24ec
SYNCERA_PROD_CLIENT_SECRET=REPLACE_ME
SYNCERA_PROD_DEFAULT_ESTATE=3B
SAP_ESTATES=CR:3A,TH:3J,PN:3B,AC:3B,AM:3A,BU:3A,BU:3D,TH:3F,SI:3A,BU:3C,TH:3O,WS:3A,TS:3A,TS:3B,AJ:3A,SU:3B,PT:3A,AC:3A,GN:3A,PN:3A,SA:3A,GN:3C,GN:3B,PT:3B,WW:3A,TH:3G,WW:3B,CM:3B,TH:3B,SI:3B,JJ:9A,TH:3M,SU:3A,TH:3K,TH:3N,TH:3L,PN:3C,KU:3A,TH:3Q,PD:3A,TH:3P,TH:3T,IP:3A,TH:3R,TH:3H,TH:3I,PD:3B,KB:9A,CM:3A,NJ:3A,BS:3A,BU:3B,JJ:3A,TH:3E,TH:3A,TH:3S,TH:3C,TH:3D,JJ:3B
# Syncera allows about 10 requests a minute; requests are started at this pace.
SAP_REQUESTS_PER_MINUTE=9
# Previous months are pulled again after this many days and on the first refresh of a month.
SAP_HISTORY_REFRESH_DAYS=7

# --- Open-Meteo -------------------------------------------------------------------
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ECMWF_URL=https://api.open-meteo.com/v1/ecmwf
HTTP_USER_AGENT=plantation-rainfall-dashboard/2.0 (production)
HISTORICAL_RAINFALL_START_DATE=2000-01-01
SOIL_MOISTURE_START_DATE=2017-01-01
# Refreshes re-download only this many days before the last stored day.
HISTORY_OVERLAP_DAYS=14
ALL_REGIONS_FORECAST_DAYS=14
FORECAST_SNAPSHOT_RETENTION_RUNS=90
PLANTATION_FORECAST_DAYS=14
PLANTATION_PAST_DAYS=92

# --- Files (inside the container) ---------------------------------------------------
ESTATE_WORKBOOK=backend/reference_data/koordinat_estate_update.xlsx
WORK_DIR=data/work
