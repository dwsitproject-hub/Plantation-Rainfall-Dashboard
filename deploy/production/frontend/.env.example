# PRODUCTION frontend settings. Copy to .env on the frontend server (172.28.80.50):
#   cp .env.example .env
# docker compose reads .env from this folder automatically. Never commit .env.

# Backend server, private address and published port (deploy/production/backend).
BACKEND_URL=http://172.28.80.51:5070

# Users open http://plantation-rainfall.kpndomain.com/ : the server's own nginx (ports 80/443)
# forwards that name to this container (deploy/production/frontend/host-nginx/). The container
# listens on the loopback address only, so the domain is the only way in.
FRONTEND_HOST_PORT=127.0.0.1:3070

# Requests reach this container only through the server's nginx (loopback port above), so it
# may report the visitor's address (X-Real-IP). Keep this only with a 127.0.0.1 port binding.
TRUSTED_PROXY_CIDR=0.0.0.0/0
