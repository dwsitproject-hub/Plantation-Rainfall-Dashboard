# Plantation Rainfall Dashboard - environment settings.
#
# Copy this file to .env and fill in the values marked REPLACE_ME.
# .env holds live secrets: never commit or share it (it is in .gitignore).
# Real environment variables always override values in this file.

# --- PostgreSQL 18 ----------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=plantation_rainfall
DATABASE_USER=rainfall_app
DATABASE_PASSWORD=REPLACE_ME
# disable | prefer | require | verify-full (use require for Apsara RDS with SSL on).
DATABASE_SSLMODE=prefer
# Open database connections kept per backend process.
DATABASE_POOL_SIZE=10

# --- Dashboard web server ---------------------------------------------------
# 0.0.0.0 listens on every network interface (LAN access); 127.0.0.1 = this PC only.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
# Address opened by the launcher and printed for users, e.g. http://192.168.1.82:8080/
DASHBOARD_PUBLIC_URL=http://localhost:8080/

# --- Sign-in and sessions -----------------------------------------------------
# Hours a sign-in stays valid.
SESSION_HOURS=12
# true when users reach the dashboard over HTTPS (e.g. behind a TLS reverse proxy).
SESSION_COOKIE_SECURE=false
# Lock an account for LOGIN_LOCKOUT_MINUTES after this many wrong passwords in a row.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12
# true only when the backend is reachable solely through the frontend proxy
# (docker compose sets this for the backend container).
TRUST_PROXY_HEADERS=false
# Email + password sign-in on the dashboard (keep on for a break-glass administrator).
LOCAL_LOGIN_ENABLED=true

# --- DWS Hub single sign-on (OIDC code + PKCE); see docs/DEPLOYMENT_STAGING.md ----
SSO_ENABLED=false
SSO_LABEL=Sign in with DWS Hub
SSO_DISCOVERY_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=
SSO_AUTHORIZATION_URL=
SSO_SCOPES=openid profile email
SSO_AUTO_PROVISION_ROLE=

# --- SAP / Syncera rainfall API ---------------------------------------------
# Only PROD is used. It returns about the current month per estate; every refresh
# adds it to the PROD history already stored in the database.
SYNCERA_PROD_BASE_URL=https://syncera.gamasap.com/api/v1
SYNCERA_PROD_CLIENT_ID=cli_300bf7eb24ec
SYNCERA_PROD_CLIENT_SECRET=REPLACE_ME
SYNCERA_PROD_DEFAULT_ESTATE=3B

# Company:estate pairs pulled from SAP, comma separated.
SAP_ESTATES=CR:3A,TH:3J,PN:3B,AC:3B,AM:3A,BU:3A,BU:3D,TH:3F,SI:3A,BU:3C,TH:3O,WS:3A,TS:3A,TS:3B,AJ:3A,SU:3B,PT:3A,AC:3A,GN:3A,PN:3A,SA:3A,GN:3C,GN:3B,PT:3B,WW:3A,TH:3G,WW:3B,CM:3B,TH:3B,SI:3B,JJ:9A,TH:3M,SU:3A,TH:3K,TH:3N,TH:3L,PN:3C,KU:3A,TH:3Q,PD:3A,TH:3P,TH:3T,IP:3A,TH:3R,TH:3H,TH:3I,PD:3B,KB:9A,CM:3A,NJ:3A,BS:3A,BU:3B,JJ:3A,TH:3E,TH:3A,TH:3S,TH:3C,TH:3D,JJ:3B
# Syncera allows about 10 requests a minute; requests are started at this pace.
SAP_REQUESTS_PER_MINUTE=9
# Previous months are pulled again after this many days and on the first refresh of a month.
SAP_HISTORY_REFRESH_DAYS=7

# --- Open-Meteo ---------------------------------------------------------------
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ECMWF_URL=https://api.open-meteo.com/v1/ecmwf
HTTP_USER_AGENT=plantation-rainfall-dashboard/2.0

HISTORICAL_RAINFALL_START_DATE=2000-01-01
SOIL_MOISTURE_START_DATE=2017-01-01
# Refreshes re-download only this many days before the last stored day.
HISTORY_OVERLAP_DAYS=14
# All Regions forecast runs from today to today + N days.
ALL_REGIONS_FORECAST_DAYS=14
# Number of daily forecast runs kept for "Forecast changes" and "Last week accuracy".
FORECAST_SNAPSHOT_RETENTION_RUNS=90
PLANTATION_FORECAST_DAYS=14
PLANTATION_PAST_DAYS=92

# --- Files --------------------------------------------------------------------
ESTATE_WORKBOOK=backend/reference_data/koordinat_estate_update.xlsx
# Temporary staging folder used during a refresh.
WORK_DIR=data/work
